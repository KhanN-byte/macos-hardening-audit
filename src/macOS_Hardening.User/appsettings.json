{
  "Monitoring": {
    "Enabled": false,
    "FailedAttemptsThreshold": 3,
    "SevereAttemptsThreshold": 5,
    "CriticalAttemptsThreshold": 10,
    "DetectionWindowMinutes": 5,
    "AlertCooldownMinutes": 5,
    "DeduplicationRetentionSeconds": 600,
    "DeduplicationCapacity": 10000
  },
  "Storage": {
    "Directory": "./data",
    "RetentionDays": 7,
    "MaxFileBytes": 10485760
  },
  "Collection": {
    "ExecutablePath": "/usr/bin/log",
    "Predicate": "eventMessage CONTAINS \"authFailWithMessage:\"",
    "BufferCapacity": 128,
    "MaxRecordBytes": 262144,
    "MaxDepth": 32,
    "InitialRestartSeconds": 1,
    "MaxRestartSeconds": 30,
    "StableRunSeconds": 60,
    "ShutdownSeconds": 5
  }
}
